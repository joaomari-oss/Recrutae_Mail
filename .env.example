# Copie para .env.local e preencha. Nunca commite valores reais.

# ── IA ────────────────────────────────────────────────────────────────────
# OpenAI é o provedor padrão; Groq entra como reserva quando ele falha.
OPENAI_API_KEY=sk-your_openai_api_key_here
# Groq API — https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Envio ─────────────────────────────────────────────────────────────────
# Resend API — https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Email remetente verificado no Resend
RESEND_FROM_EMAIL=seu@email.com
# Remetente da Divulgação ROS — precisa ser do domínio recrutae.com.br
ROS_FROM_EMAIL=contato@recrutae.com.br

# ── Descadastro e webhooks ────────────────────────────────────────────────
# Endereço público da aplicação. Precisa ser HTTPS: os links de descadastro
# de um clique (RFC 8058) são construídos a partir dele.
APP_BASE_URL=https://mail.example.com
# Assina os tokens de descadastro. Use 32 caracteres aleatórios ou mais.
UNSUBSCRIBE_SIGNING_SECRET=use-at-least-32-random-characters
# O mesmo segredo configurado no endpoint de webhook do Resend.
RESEND_WEBHOOK_SECRET=configure-the-same-secret-in-resend

# ── Banco ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key
# Somente servidor. A supressão, a idempotência e o envio ROS dependem dela.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# ── Sessão ────────────────────────────────────────────────────────────────
# Assina o cookie de autenticação. Mínimo de 32 caracteres.
JWT_SECRET=use-at-least-32-random-characters
